@font-face {
    font-family: GameUIFont;
    src: url("../Fonts/Georama.ttf");
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    color: #f3f7ff;
    font-family: GameUIFont;
    pointer-events: none;
    focus: none;
}

#hud {
    width: 100%;
    height: 100%;
}

#damage-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #b000001c;
    border: 22px solid #ef293ccc;
    box-sizing: border-box;
    pointer-events: none;
}

#damage-overlay.hidden {
    visibility: hidden;
}

#death-red,
#death-black {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

#death-red { background-color: #a80000; }
#death-black { background-color: #000000; }
#death-red.hidden, #death-black.hidden { visibility: hidden; }

.panel {
    position: absolute;
    padding: 14px 18px;
    background-color: #101720d9;
    border: 1px #80d8ff66;
}

#objective {
    top: 32px;
    left: 32px;
}

.eyebrow {
    color: #80d8ff;
    font-size: 12px;
    letter-spacing: 2px;
}

#objective-title {
    margin-top: 6px;
    font-size: 18px;
}

#match-phase { margin-top: 5px; font-size: 16px; }
#match-strip { top: 24px; left: 42%; right: 42%; display: flex; justify-content: space-between; text-align: center; font-size: 20px; }
.alpha { color: #59bfff; }
.bravo { color: #ff675f; }
#kill-feed { position: absolute; top: 115px; right: 32px; width: 360px; text-align: right; font-size: 14px; }
.feed-entry { margin-bottom: 8px; padding: 5px 4px; background-color: #101720b8; }
#scoreboard { top: 17%; left: 22%; right: 22%; min-height: 300px; }
#scoreboard.hidden { visibility: hidden; }
.scoreboard-title { font-size: 24px; margin-bottom: 14px; }
.scoreboard-heading, .score-row { display: flex; justify-content: space-between; padding: 7px 10px; }
.scoreboard-heading { color: #a8b3c2; border-bottom: 1px solid #526273; }
.score-row.alpha-team { background-color: #168bc438; }
.score-row.bravo-team { background-color: #c43b3638; }
.score-row.local { border-left: 3px solid #ffffff; }
.player-name { width: 75%; }
.stat { width: 10%; text-align: right; }

#weapon {
    right: 32px;
    bottom: 32px;
    width: 260px;
}

.ammo {
    text-align: right;
    font-size: 36px;
}

.reserve {
    color: #a8b3c2;
    font-size: 18px;
}

#health {
    width: 100%;
    height: 8px;
    margin-top: 10px;
}

#survival-labels { display: flex; justify-content: space-between; margin-top: 8px; color: #a8b3c2; font-size: 10px; letter-spacing: 1px; }
#armour { display: flex; gap: 5px; margin-top: 7px; }
.armour-slot { width: 80px; height: 7px; background-color: #172432; border: 1px solid #33495f; }
.armour-slot.filled { background-color: #58c8ff; border-color: #9de2ff; }

#crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2px;
    height: 2px;
    margin-left: -1px;
    margin-top: -1px;
}

#crosshair.hidden {
    visibility: hidden;
}

#crosshair.headshot .arm {
    background-color: #ffb020;
}

.arm.hit {
    background-color: #ff3048;
}

#interaction {
    position: absolute;
    left: 40%;
    right: 40%;
    bottom: 18%;
    text-align: center;
    font-size: 16px;
}

.arm,
.dot {
    position: absolute;
    background-color: #ffffff;
}

.top,
.bottom {
    width: 2px;
    height: 9px;
    left: 0;
}

.left,
.right {
    width: 9px;
    height: 2px;
    top: 0;
}

/* PlayerHud sets top/left to the spread cone in vh; margins add the 9px arm
   length, the 2px centre and a 2px minimum gap so the cross never closes. */
.top {
    top: 0;
    margin-top: -11px;
}

.right {
    left: 0;
    margin-left: 4px;
}

.bottom {
    top: 0;
    margin-top: 4px;
}

.left {
    left: 0;
    margin-left: -11px;
}

.dot {
    width: 2px;
    height: 2px;
}

#objective-detail { margin-top: 8px; font-size: 13px; line-height: 20px; }
#combat-cue { position: absolute; top: 58%; left: 30%; right: 30%; text-align: center; font-size: 18px; color: #ffd479; }
#loadout-choice { position: absolute; top: 30%; left: 32px; font-size: 15px; line-height: 26px; }
#round-progress { position: absolute; bottom: 32px; left: 32px; color: #80d8ff; font-size: 15px; }
#supply-counts, #supply-use { margin-top: 7px; font-size: 10px; color: #a8b3c2; }
#weapon { width: 330px; }
.player-name { width: 65%; }
#crosshair.armour-hit .arm { background-color: #59bfff; }
#crosshair.elimination .arm { background-color: #ffdf7f; }
.incoming { position: absolute; background-color: #ff423b; }
.incoming.hidden { visibility: hidden; }
#incoming-front { top: 42%; left: 47%; width: 6%; height: 5px; }
#incoming-back { top: 58%; left: 47%; width: 6%; height: 5px; }
#incoming-left { top: 47%; left: 45%; width: 5px; height: 6%; }
#incoming-right { top: 47%; left: 55%; width: 5px; height: 6%; }

#objective { width: 365px; border-left-width: 4px; }
#objective-status { margin-top: 10px; font-size: 20px; color: #ffdf7f; }
#objective-instruction { margin-top: 7px; font-size: 14px; line-height: 20px; }
#objective-rotation { margin-top: 9px; font-size: 16px; color: #ffffff; }
#objective.friendly { border-left-color: #59bfff; }
#objective.friendly #objective-status { color: #59bfff; }
#objective.enemy { border-left-color: #ff675f; }
#objective.enemy #objective-status { color: #ff675f; }
#objective.contested { border-left-color: #ffbf47; }
#objective.contested #objective-status { color: #ffbf47; }
#score-goal { position: absolute; top: 83px; left: 35%; right: 35%; text-align: center; font-size: 13px; color: #dce8f5; }
