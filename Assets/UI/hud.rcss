@font-face {
    font-family: GameUIFont;
    src: url("../Fonts/Georama.ttf");
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    color: #f3f7ff;
    font-family: GameUIFont;
    pointer-events: none;
    focus: none;
}

#hud {
    width: 100%;
    height: 100%;
}

.panel {
    position: absolute;
    padding: 14px 18px;
    background-color: #101720d9;
    border: 1px #80d8ff66;
}

#objective {
    top: 32px;
    left: 32px;
}

.eyebrow {
    color: #80d8ff;
    font-size: 12px;
    letter-spacing: 2px;
}

#objective-title {
    margin-top: 6px;
    font-size: 18px;
}

#weapon {
    right: 32px;
    bottom: 32px;
    width: 260px;
}

.ammo {
    text-align: right;
    font-size: 36px;
}

.reserve {
    color: #a8b3c2;
    font-size: 18px;
}

#health {
    width: 100%;
    height: 8px;
    margin-top: 10px;
}

#survival-labels { display: flex; justify-content: space-between; margin-top: 8px; color: #a8b3c2; font-size: 10px; letter-spacing: 1px; }
#armour { display: flex; gap: 5px; margin-top: 7px; }
.armour-slot { width: 80px; height: 7px; background-color: #172432; border: 1px solid #33495f; }
.armour-slot.filled { background-color: #58c8ff; border-color: #9de2ff; }

#crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2px;
    height: 2px;
}

#crosshair.hidden {
    visibility: hidden;
}

#crosshair.headshot .arm {
    background-color: #ffb020;
}

.arm.hit {
    background-color: #ff3048;
}

#interaction {
    position: absolute;
    left: 40%;
    right: 40%;
    bottom: 18%;
    text-align: center;
    font-size: 16px;
}

.arm,
.dot {
    position: absolute;
    background-color: #ffffff;
}

.top,
.bottom {
    width: 2px;
    height: 9px;
    left:
        2px;
}

.left,
.right {
    width: 9px;
    height: 2px;
    top: 0;
}

.top {
    top: -18px;
}

.right {
    left: 10px;
}

.bottom {
    top: 10px;
}

.left {
    left: -18px;
}

.dot {
    width: 2px;
    height: 2px;
}
