/* Shared components. Edit theme.tokens.json / this template, then run Tools/build_ui_theme.py. */
/* @font-face { font-family: TacticalBody; src: url("../Fonts/Inter.ttf"); } */
/* @font-face { font-family: TacticalDisplay; src: url("../Fonts/Rajdhani-Regular.ttf"); } */
/* @font-face { font-family: TacticalHeading; src: url("../Fonts/Rajdhani-Bold.ttf"); } */
body { width: 100%; height: 100%; margin: 0; color: $text; font-family: TacticalBody; font-size: 14px; }
div { display: block; }
button, input { font-family: TacticalDisplay; tab-index: auto; }
.ui-panel { box-sizing: border-box; padding: 24px; background-color: #111417f2; border: 1px $border; }
.ui-heading { font-family: TacticalHeading; font-size: 40px; line-height: 44px; }
.ui-eyebrow { font-family: TacticalDisplay; color: $muted; font-size: 12px; letter-spacing: 2px; }
.ui-meta { font-family: TacticalDisplay; color: $muted; font-size: 12px; letter-spacing: 1px; }
.ui-rule { height: 1px; background-color: $border; }
.ui-button { box-sizing: border-box; height: 46px; padding: 0 16px; line-height: 44px; border: 1px $border; background-color: $panel; color: $text; font-family: TacticalHeading; font-size: 18px; text-align: center; }
.ui-button:hover, .ui-button:focus { border-color: $accent; background-color: #25241c; }
.ui-button:active { background-color: $accent; color: $background; }
.ui-button.primary { background-color: $accent; border-color: $accent; color: $background; }
.ui-button.primary:hover, .ui-button.primary:focus { background-color: #ffca58; border-color: #ffca58; }
.ui-button.primary:active { background-color: #e39708; }
.ui-button:disabled { color: $muted; background-color: $elevated; border-color: $border; }
.ui-tab { box-sizing: border-box; padding: 10px 12px; border: 1px $border; background-color: $panel; color: $muted; font-family: TacticalDisplay; font-size: 16px; text-align: left; }
.ui-tab:hover, .ui-tab:focus { color: $text; border-color: $accent; }
.ui-tab.selected { color: $text; background-color: #ffb31a0d; border-bottom: 2px $accent; }
.ui-key { display: inline-block; min-width: 22px; height: 22px; line-height: 22px; padding: 0 4px; margin-right: 8px; border: 1px $text; color: $text; font-family: TacticalHeading; text-align: center; }
.ui-icon { width: 24px; height: 24px; }
.ui-field { box-sizing: border-box; height: 46px; padding: 8px 12px; background-color: $background; border: 1px $border; color: $text; font-family: TacticalBody; font-size: 15px; caret-color: $accent;  }
.ui-field:hover, .ui-field:focus { border-color: $accent; }
.ui-stat { font-family: TacticalHeading; font-size: 36px; line-height: 38px; }
.friendly { color: $friendly; }
.enemy { color: $enemy; }
.accent { color: $accent; }
progress { background-color: $border; border: 0; }
progress fill { background-color: $text; }
.ui-progress fill { background-color: $accent; }
