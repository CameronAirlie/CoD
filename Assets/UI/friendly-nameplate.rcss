/* Generated stylesheet source; shared tokens are defined in theme.tokens.json. */
body { width: 120px; height: 18px; display: flex; justify-content: center; align-items: center; overflow: hidden; pointer-events: none; font-family: TacticalDisplay; }
#nameplate { width: 120px; height: 18px; text-align: center; white-space: nowrap; overflow: hidden; color: #4DA8FF; font-size: 11px; line-height: 18px; font-effect: shadow(1px 1px #090B0D); }
#friendly-name.friendly { color: #4DA8FF; }
#friendly-name.enemy { color: #F05252; }
