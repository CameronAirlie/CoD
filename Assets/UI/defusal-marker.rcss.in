/* Generated stylesheet source; shared tokens are defined in theme.tokens.json. */
body { width: 140px; height: 20px; pointer-events: none; font-family: TacticalDisplay; }
#marker { width: 140px; height: 20px; line-height: 20px; text-align: center; white-space: nowrap; overflow: hidden; color: ${text}; font-size: 11px; font-effect: shadow(1px 1px ${background}); }
#marker.hidden { visibility: hidden; }
#marker.contested { color: ${critical}; }
