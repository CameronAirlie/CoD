/* Generated stylesheet source; shared tokens are defined in theme.tokens.json. */
body { width: 240px; height: 30px; pointer-events: none; font-family: TacticalDisplay; }
#marker { box-sizing: border-box; width: 240px; height: 30px; line-height: 28px; text-align: center; color: ${text}; background-color: ${background}99; border: 1px ${border}; border-left: 2px ${text}; font-size: 12px; }
.marker-icon { display: inline-block; width: 16px; height: 16px; line-height: 16px; margin-right: 5px; vertical-align: middle; text-align: center; font-weight: bold; }
#marker.hidden { visibility: hidden; }
#marker.contested { color: ${critical}; border-left-color: ${critical}; }
