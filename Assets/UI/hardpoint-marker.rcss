/* Generated stylesheet source; shared tokens are defined in theme.tokens.json. */
body { width: 240px; height: 30px; pointer-events: none; font-family: TacticalDisplay; }
#marker { box-sizing: border-box; width: 240px; height: 30px; line-height: 28px; text-align: center; color: #FFB31A; background-color: #090B0D99; border: 1px #2A3036; border-left: 2px #FFB31A; font-size: 12px; }
.marker-icon { display: inline-block; width: 16px; height: 16px; line-height: 16px; margin-right: 5px; vertical-align: middle; text-align: center; font-weight: bold; }
#marker.hidden { visibility: hidden; }
#marker.friendly { color: #4DA8FF; border-left-color: #4DA8FF; }
#marker.enemy { color: #F05252; border-left-color: #F05252; }
#marker.contested { color: #FFB31A; border-left-color: #FFB31A; }
