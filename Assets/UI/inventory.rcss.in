/* Generated stylesheet source; shared tokens are defined in theme.tokens.json. */
#inventory-backdrop { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; background-color: ${background}cc; }
#inventory-panel { width: 900px; max-width: 92%; padding: 24px; border-top: 2px ${accent}; }
#header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px ${border}; padding-bottom: 16px; }
.title { margin-top: 4px; }
.section-label { display: flex; justify-content: space-between; margin: 16px 0 12px; }
#weapon-grid { display: flex; gap: 12px; }
.weapon-card { box-sizing: border-box; width: 33.33%; padding: 12px; border: 1px ${border}; background-color: ${background}; color: ${text}; text-align: left; }
.weapon-card:hover, .weapon-card:focus { border-color: ${accent}; background-color: ${elevated}; }
.weapon-card.selected { border-color: ${accent}; background-color: ${accent}0c; }
.card-top { display: flex; justify-content: space-between; }
.card-top .ui-meta { font-size: 10px; }
.equipped-tag { visibility: hidden; font-family: TacticalDisplay; font-size: 10px; color: ${accent}; }
.selected .equipped-tag { visibility: visible; }
.weapon-portrait { display: block; width: 100%; height: 100px; }
.weapon-card-name { font-family: TacticalHeading; font-size: 28px; }
.weapon-stats { margin-top: 4px; font-family: TacticalDisplay; font-size: 11px; color: ${secondary}; }
#inventory-grid { display: flex; flex-wrap: wrap; gap: 10px; }
.slot { box-sizing: border-box; width: 23.9%; height: 104px; padding: 12px; background-color: ${background}; border: 1px ${border}; color: ${muted}; }
.slot:hover { border-color: ${accent}; }
.slot.occupied { cursor: move; color: ${text}; background-color: ${elevated}; }
.slot.dragging { opacity: 0.4; border-color: ${accent}; }
.item-type { color: ${muted}; font-family: TacticalDisplay; font-size: 10px; letter-spacing: 1px; }
.item-name { margin-top: 6px; font-family: TacticalHeading; font-size: 19px; }
.item-count { margin-top: 6px; color: ${secondary}; font-family: TacticalDisplay; font-size: 12px; }
.item-icon { float: right; width: 30px; height: 30px; margin-top: 4px; }
.empty-label { margin-top: 28px; text-align: center; font-family: TacticalDisplay; font-size: 10px; letter-spacing: 2px; }
#footer { display: flex; justify-content: space-between; margin-top: 16px; border-top: 1px ${border}; padding-top: 16px; }
.close-hint { color: ${accent}; }
@media (max-height: 650px) { #inventory-panel { padding: 16px; } #header { padding-bottom: 8px; } .title { font-size: 30px; line-height: 32px; } .section-label { margin: 10px 0 8px; } .weapon-portrait { height: 64px; } .slot { height: 80px; padding: 8px; } .item-name { font-size: 16px; } #footer { margin-top: 8px; padding-top: 8px; } }
