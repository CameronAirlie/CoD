/* Generated stylesheet source; shared tokens are defined in theme.tokens.json. */
#inventory-backdrop { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; background-color: ${background}cc; }
#inventory-panel { width: 900dp; max-width: 92%; padding: 24dp; border-top: 2dp ${accent}; }
#header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1dp ${border}; padding-bottom: 16dp; }
.title { margin-top: 4dp; }
.section-label { display: flex; justify-content: space-between; margin: 16dp 0 12dp; }
#weapon-grid { display: flex; gap: 12dp; }
.weapon-card { box-sizing: border-box; width: 33.33%; padding: 12dp; border: 1dp ${border}; background-color: ${background}; color: ${text}; text-align: left; }
.weapon-card:hover, .weapon-card:focus { border-color: ${accent}; background-color: ${elevated}; }
.weapon-card.selected { border-color: ${accent}; background-color: ${accent}0c; }
.card-top { display: flex; justify-content: space-between; }
.card-top .ui-meta { font-size: 10dp; }
.equipped-tag { visibility: hidden; font-family: TacticalDisplay; font-size: 10dp; color: ${accent}; }
.selected .equipped-tag { visibility: visible; }
.weapon-portrait { display: block; width: 100%; height: 100dp; }
.weapon-card-name { font-family: TacticalHeading; font-size: 28dp; }
.weapon-stats { margin-top: 4dp; font-family: TacticalDisplay; font-size: 11dp; color: ${secondary}; }
#inventory-grid { display: flex; flex-wrap: wrap; gap: 10dp; }
.slot { box-sizing: border-box; width: 23.9%; height: 104dp; padding: 12dp; background-color: ${background}; border: 1dp ${border}; color: ${muted}; }
.slot:hover { border-color: ${accent}; }
.slot.occupied { cursor: move; color: ${text}; background-color: ${elevated}; }
.slot.dragging { opacity: 0.4; border-color: ${accent}; }
.item-type { color: ${muted}; font-family: TacticalDisplay; font-size: 10dp; letter-spacing: 1dp; }
.item-name { margin-top: 6dp; font-family: TacticalHeading; font-size: 19dp; }
.item-count { margin-top: 6dp; color: ${secondary}; font-family: TacticalDisplay; font-size: 12dp; }
.item-icon { float: right; width: 30dp; height: 30dp; margin-top: 4dp; }
.empty-label { margin-top: 28dp; text-align: center; font-family: TacticalDisplay; font-size: 10dp; letter-spacing: 2dp; }
#footer { display: flex; justify-content: space-between; margin-top: 16dp; border-top: 1dp ${border}; padding-top: 16dp; }
.close-hint { color: ${accent}; }
@media (max-height: 650px) { #inventory-panel { padding: 16dp; } #header { padding-bottom: 8dp; } .title { font-size: 30dp; line-height: 32dp; } .section-label { margin: 10dp 0 8dp; } .weapon-portrait { height: 64dp; } .slot { height: 80dp; padding: 8dp; } .item-name { font-size: 16dp; } #footer { margin-top: 8dp; padding-top: 8dp; } }
