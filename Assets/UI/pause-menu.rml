<rml><head><title>Pause / Operations</title><link type="text/rcss" href="theme.rcss" /><link type="text/rcss" href="pause-menu.rcss" /><link type="text/rcss" href="settings.rcss" /></head>
<body id="menu-body"><div id="backdrop"><div id="menu" class="ui-panel"><div class="ui-eyebrow accent">TACTICAL OPERATIONS</div><div class="ui-heading">PAUSED</div><div class="pause-description">Return to the fight when ready.</div>

<button id="resume" class="ui-button primary">RESUME <span class="pause-arrow">&gt;</span></button><button id="graphics-preset" class="ui-button">SETTINGS</button><button id="switch-team" class="ui-button">SWITCH TEAM</button><button id="restart" class="ui-button">RESTART CHECKPOINT</button><div class="ui-rule" /><button id="main-menu" class="ui-button">RETURN TO MAIN MENU</button><button id="quit" class="ui-button">QUIT GAME</button><div class="hint ui-meta"><span class="keyboard-only"><span class="ui-key">ESC</span> RETURN TO GAME</span><span class="controller-only">LS / D-PAD MOVE / A SELECT / B BACK / START RESUME</span></div>
</div></div><div id="settings-overlay"><div id="settings-panel" class="ui-panel"><div class="ui-heading">SETTINGS</div><div class="settings-layout"><div class="settings-tabs"><button id="settings-tab-display" class="ui-tab selected">Display</button><button id="settings-tab-graphics" class="ui-tab">Graphics</button><button id="settings-tab-audio" class="ui-tab">Audio</button><button id="settings-tab-interface" class="ui-tab">Interface</button><button id="settings-tab-controls" class="ui-tab">Controls</button></div><div class="settings-content"><div id="settings-section-display" class="settings-section settings-active"><div class="settings-section-heading ui-eyebrow accent">DISPLAY</div><div class="settings-card"><div class="settings-card-info"><label for="setting-vsync" class="settings-card-label">VSync</label><div class="settings-card-description">Synchronize frames with your display.</div></div><div class="settings-card-control"><button id="setting-vsync" class="ui-button settings-toggle">OFF</button></div></div><div class="settings-card"><div class="settings-card-info"><label for="setting-fullscreen" class="settings-card-label">Borderless fullscreen</label><div class="settings-card-description">Fill the current monitor without window borders.</div></div><div class="settings-card-control"><button id="setting-fullscreen" class="ui-button settings-toggle">OFF</button></div></div><div class="settings-card"><div class="settings-card-info"><label for="setting-fov" class="settings-card-label">Field of view</label><div class="settings-card-description">Base vertical camera FOV (80 - 110 degrees).</div></div><div class="settings-card-control settings-slider-control"><span id="setting-fov-value" class="setting-value">90&#176;</span><input id="setting-fov" class="settings-slider" type="range" min="80" max="110" step="1" value="90" /></div></div></div><div id="settings-section-graphics" class="settings-section"><div class="settings-section-heading ui-eyebrow accent">GRAPHICS</div><div class="settings-card"><div class="settings-card-info"><label for="setting-quality" class="settings-card-label">Graphics quality</label><div class="settings-card-description">Choose a rendering quality preset.</div></div><div class="settings-card-control"><button id="setting-quality" class="ui-button settings-toggle">HIGH</button></div></div></div><div id="settings-section-audio" class="settings-section"><div class="settings-section-heading ui-eyebrow accent">AUDIO</div><div class="settings-card"><div class="settings-card-info"><label for="setting-master" class="settings-card-label">Master volume</label><div class="settings-card-description">Overall sound level.</div></div><div class="settings-card-control settings-slider-control"><span id="setting-master-value" class="setting-value">100%</span><input id="setting-master" class="settings-slider" type="range" min="0" max="1" step="0.01" value="1" /></div></div><div class="settings-card"><div class="settings-card-info"><label for="setting-effects" class="settings-card-label">Effects volume</label><div class="settings-card-description">Weapons, reloads, and gameplay sounds.</div></div><div class="settings-card-control settings-slider-control"><span id="setting-effects-value" class="setting-value">100%</span><input id="setting-effects" class="settings-slider" type="range" min="0" max="1" step="0.01" value="1" /></div></div><div class="settings-card"><div class="settings-card-info"><label for="setting-feedback" class="settings-card-label">Feedback volume</label><div class="settings-card-description">Hit markers and combat feedback.</div></div><div class="settings-card-control settings-slider-control"><span id="setting-feedback-value" class="setting-value">100%</span><input id="setting-feedback" class="settings-slider" type="range" min="0" max="1" step="0.01" value="1" /></div></div></div><div id="settings-section-interface" class="settings-section"><div class="settings-section-heading ui-eyebrow accent">INTERFACE</div><div class="settings-card"><div class="settings-card-info"><label for="setting-scale" class="settings-card-label">Interface scale</label><div class="settings-card-description">Adjust the size of menus and the HUD.</div></div><div class="settings-card-control settings-slider-control"><span id="setting-scale-value" class="setting-value">1.00x</span><input id="setting-scale" class="settings-slider" type="range" min="0.75" max="1.25" step="0.01" value="1" /></div></div></div><div id="settings-section-controls" class="settings-section"><div class="settings-section-heading ui-eyebrow accent">CONTROLS</div><div class="settings-card"><div class="settings-card-info"><label for="setting-mouse" class="settings-card-label">Mouse sensitivity</label><div class="settings-card-description">Aim speed multiplier; preserves ADS scaling.</div></div><div class="settings-card-control settings-slider-control"><span id="setting-mouse-value" class="setting-value">1.00x</span><input id="setting-mouse" class="settings-slider" type="range" min="0.1" max="3" step="0.05" value="1" /></div></div><div class="settings-card"><div class="settings-card-info"><label for="setting-aim-assist" class="settings-card-label">Controller aim assist</label><div class="settings-card-description">Gentle aim slowdown near visible enemies while aiming down sights. Controller only; 0% disables it.</div></div><div class="settings-card-control settings-slider-control"><span id="setting-aim-assist-value" class="setting-value">50%</span><input id="setting-aim-assist" class="settings-slider" type="range" min="0" max="1" step="0.05" value="0.5" /></div></div></div></div></div><div class="menu-controller-hint ui-meta"><span class="controller-only">LS / D-PAD MOVE / A SELECT / B BACK / LB-RB TABS / LEFT-RIGHT ADJUST</span><span class="keyboard-only">TAB NAVIGATE / ENTER SELECT / ARROWS ADJUST</span></div><div id="settings-status">Changes apply and save immediately.</div><button id="settings-reset" class="ui-button">RESTORE DEFAULTS</button><button id="settings-close" class="ui-button primary">BACK</button></div></div><div id="confirm-overlay"><div id="confirm-panel" class="ui-panel"><div id="confirm-title" class="ui-heading">LEAVE MATCH?</div><div id="confirm-message" class="ui-meta"></div><div class="confirm-actions"><button id="confirm-cancel" class="ui-button primary">CANCEL</button><button id="confirm-accept" class="ui-button">CONFIRM</button></div><div class="menu-controller-hint ui-meta"><span class="controller-only">LEFT-RIGHT CHOOSE / A SELECT / B CANCEL</span><span class="keyboard-only">TAB NAVIGATE / ENTER SELECT / ESC CANCEL</span></div></div></div></body></rml>
