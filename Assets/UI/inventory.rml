<rml><head><title>Loadout / Inventory</title><link type="text/rcss" href="theme.rcss"/><link type="text/rcss" href="inventory.rcss"/></head>
<body id="menu-body"><div id="inventory-backdrop"><div id="inventory-panel" class="ui-panel">
<div id="header"><div><div class="ui-eyebrow accent">02 / EQUIPMENT</div><div class="title ui-heading">LOADOUT</div></div><div class="ui-meta"><span id="inventory-mode">BUY / INVENTORY</span> / <span id="input-hint-1" data-input-prompt="{MenuBack} CLOSE"></span></div></div>
<div id="loadout-selector">
<div class="section-label"><span class="ui-eyebrow">CHOOSE YOUR LOADOUT</span><span class="ui-meta">SELECT ANYTIME / APPLIES NEXT SPAWN</span></div>
<div id="loadout-state" class="ui-meta">CURRENT: ASSAULT / NEXT SPAWN: ASSAULT</div>
<div id="loadout-grid">
<button id="loadout-Assault" class="loadout-card"><img src="Weapons/ar.tga" class="loadout-portrait"/><div class="loadout-name">ASSAULT</div><div class="loadout-details">AR-24 + P-12<br/>150 RESERVE / 1 MED KIT / 1 PLATE<br/>FRAG + FLASH</div><div id="loadout-action-Assault" class="loadout-action">SELECT FOR NEXT SPAWN</div></button>
<button id="loadout-Medic" class="loadout-card"><img src="Weapons/pistol.tga" class="loadout-portrait"/><div class="loadout-name">MEDIC</div><div class="loadout-details">P-12 SIDEARM<br/>60 RESERVE / 3 MED KITS<br/>SMOKE + FLASH</div><div id="loadout-action-Medic" class="loadout-action">SELECT FOR NEXT SPAWN</div></button>
<button id="loadout-Defender" class="loadout-card"><img src="Weapons/lmg.tga" class="loadout-portrait"/><div class="loadout-name">DEFENDER</div><div class="loadout-details">MG-60 + P-12<br/>90 RESERVE / 1 MED KIT / 3 PLATES<br/>FRAG + MOLOTOV</div><div id="loadout-action-Defender" class="loadout-action">SELECT FOR NEXT SPAWN</div></button>
</div></div>
<div id="buy-equipment">
<div id="shop-summary"><div><div class="ui-eyebrow">AVAILABLE FUNDS</div><div id="shop-balance">$800</div></div><div id="shop-window" class="ui-eyebrow">BUY OPEN</div></div>
<div id="shop-status" class="ui-meta">Choose an item to buy.</div>
<div class="section-label"><span class="ui-eyebrow">BUY EQUIPMENT</span><span class="ui-meta">ONE PRIMARY / ONE SIDEARM</span></div>
<div id="shop-grid"><button id="buy-pistol" class="shop-button">P-12 / $200</button><button id="buy-ar" class="shop-button">AR-24 / $2700</button><button id="buy-lmg" class="shop-button">MG-60 / $3200</button><button id="buy-frag" class="shop-button">FRAG / $300</button><button id="buy-flash" class="shop-button">FLASH / $200</button><button id="buy-smoke" class="shop-button">SMOKE / $300</button><button id="buy-molotov" class="shop-button">MOLOTOV / $400</button></div>
</div>
<div class="section-label"><span class="ui-eyebrow">SELECT THROWABLE</span><span id="throwable-capacity" class="ui-meta">2/4 CARRIED</span></div><div id="throwable-grid"><button id="select-frag" class="shop-button">FRAG</button><button id="select-flash" class="shop-button">FLASH</button><button id="select-smoke" class="shop-button">SMOKE</button><button id="select-molotov" class="shop-button">MOLOTOV</button></div>
<div class="section-label"><span class="ui-eyebrow">WEAPON SYSTEMS</span><span class="ui-meta">SELECT OWNED WEAPONS TO EQUIP</span></div>
<div id="weapon-grid">
<button id="weapon-0" class="weapon-card selected"><div class="card-top"><span class="ui-meta">01 / ASSAULT RIFLE</span><span class="equipped-tag">EQUIPPED</span></div><img src="Weapons/ar.tga" class="weapon-portrait"/><div class="weapon-card-name">AR-24</div><div id="weapon-stats-0" class="weapon-stats"></div></button>
<button id="weapon-1" class="weapon-card"><div class="card-top"><span class="ui-meta">02 / HANDGUN</span><span class="equipped-tag">EQUIPPED</span></div><img src="Weapons/pistol.tga" class="weapon-portrait"/><div class="weapon-card-name">P-12</div><div id="weapon-stats-1" class="weapon-stats"></div></button>
<button id="weapon-2" class="weapon-card"><div class="card-top"><span class="ui-meta">03 / MACHINE GUN</span><span class="equipped-tag">EQUIPPED</span></div><img src="Weapons/lmg.tga" class="weapon-portrait"/><div class="weapon-card-name">MG-60</div><div id="weapon-stats-2" class="weapon-stats"></div></button>
</div>
<div class="section-label"><span class="ui-eyebrow">SUPPLIES / DRAG TO REORDER</span><span id="inventory-capacity" class="capacity ui-meta">0/8 CAPACITY</span></div>
<div id="inventory-grid"><div id="slot-0" class="slot"></div><div id="slot-1" class="slot"></div><div id="slot-2" class="slot"></div><div id="slot-3" class="slot"></div><div id="slot-4" class="slot"></div><div id="slot-5" class="slot"></div><div id="slot-6" class="slot"></div><div id="slot-7" class="slot"></div></div>
<div id="footer"><span class="ui-meta"><span id="input-hint-2" data-input-prompt="{MenuAccept} EQUIP / BUY / USE / {MenuSecondary} PICK UP"></span></span><span class="close-hint ui-meta"><span id="input-hint-3" data-input-prompt="{MenuBack} CLOSE"></span></span></div>
</div></div></body></rml>
