<rml>
    <head>
        <title>Inventory</title>
        <link type="text/rcss" href="inventory.rcss" />
    </head>
    <body>
        <div id="inventory-backdrop">
            <div id="inventory-panel">
                <div id="header">
                    <div><div class="eyebrow">LOADOUT</div><div class="title">INVENTORY</div></div>
                    <div id="inventory-capacity" class="capacity">0/8 CAPACITY</div>
                </div>
                <div id="inventory-grid">
                    <div id="slot-0" class="slot"></div><div id="slot-1" class="slot"></div><div id="slot-2" class="slot"></div><div id="slot-3" class="slot"></div><div id="slot-4" class="slot"></div>
                    <div id="slot-5" class="slot"></div><div id="slot-6" class="slot"></div><div id="slot-7" class="slot"></div>


                </div>
                <div id="footer"><span>H MED KIT (1s) / G ARMOUR (0.5s)</span><span class="close-hint">I / ESC CLOSE</span></div>
            </div>
        </div>
    </body>
</rml>
