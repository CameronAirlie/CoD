/* Generated stylesheet source; shared tokens are defined in theme.tokens.json. */
body { pointer-events: none; focus: none; }
#hud { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.panel { position: absolute; box-sizing: border-box; padding: 12dp 16dp; background-color: ${panel}b8; border: 1dp ${border}; }
.eyebrow { color: ${secondary}; font-family: TacticalDisplay; font-size: 11dp; letter-spacing: 2dp; }
#objective { top: 32dp; left: 32dp; width: 288dp; border-left: 2dp ${accent}; }
#match-phase { margin-top: 4dp; color: ${secondary}; font-family: TacticalDisplay; font-size: 12dp; }
#objective-status { margin-top: 10dp; font-family: TacticalHeading; font-size: 20dp; line-height: 23dp; color: ${accent}; }
#objective-detail { margin-top: 8dp; font-size: 11dp; line-height: 17dp; color: ${secondary}; }
#objective-instruction { margin-top: 7dp; font-size: 11dp; line-height: 17dp; }
#objective-rotation { margin-top: 9dp; font-family: TacticalDisplay; font-size: 14dp; }
#objective.friendly { border-left-color: ${friendly}; } #objective.friendly #objective-status { color: ${friendly}; }
#objective.enemy { border-left-color: ${enemy}; } #objective.enemy #objective-status { color: ${enemy}; }
#objective.contested { border-left-color: ${accent}; } #objective.contested #objective-status { color: ${accent}; }
#compass { position: absolute; top: 24dp; left: 50%; margin-left: -160dp; width: 320dp; text-align: center; font-family: TacticalDisplay; font-effect: shadow(1dp 1dp ${background}); }
#compass-ticks { display: flex; justify-content: space-between; height: 24dp; font-size: 12dp; border-bottom: 1dp ${secondary}55; }
.compass-tick { width: 44dp; text-align: center; padding-bottom: 5dp; }
.compass-pointer { width: 2dp; height: 8dp; background-color: ${accent}; margin: -5dp auto 2dp; }
#compass-heading { font-size: 18dp; }
#match-strip { top: 80dp; left: 50%; margin-left: -104dp; width: 208dp; display: flex; justify-content: space-between; align-items: center; padding: 4dp 16dp; font-family: TacticalHeading; font-size: 24dp; background-color: ${background}88; }
#match-clock { color: ${secondary}; font-family: TacticalDisplay; font-size: 16dp; }
.alpha { color: ${friendly}; } .bravo { color: ${enemy}; }
#score-goal { position: absolute; top: 120dp; left: 35%; right: 35%; text-align: center; font-family: TacticalDisplay; font-size: 11dp; color: ${secondary}; }
#kill-feed { position: absolute; top: 268dp; right: 32dp; width: 280dp; text-align: right; font-family: TacticalDisplay; font-size: 13dp; }
.feed-entry { margin-bottom: 5dp; padding: 5dp 8dp; background-color: ${background}77; }
#scoreboard { top: 22%; left: 22%; right: 22%; min-height: 260dp; background-color: ${panel}f2; border-top: 2dp ${accent}; }
#scoreboard.hidden { visibility: hidden; }
.scoreboard-title { font-family: TacticalHeading; font-size: 28dp; margin-bottom: 14dp; }
.scoreboard-heading, .score-row { display: flex; justify-content: space-between; padding: 7dp 10dp; }
.scoreboard-heading { color: ${muted}; font-family: TacticalDisplay; font-size: 12dp; border-bottom: 1dp ${border}; }
.score-row.alpha-team { background-color: ${friendly}15; } .score-row.bravo-team { background-color: ${enemy}15; }
.score-row.local { border-left: 2dp ${accent}; }
.player-name { width: 65%; } .stat { width: 10%; text-align: right; }
#weapon { right: 32dp; bottom: 32dp; width: 250dp; padding: 0; background-color: transparent; border: 0; text-align: right; font-effect: shadow(1dp 1dp ${background}); }
#weapon-name { font-family: TacticalHeading; font-size: 17dp; margin-bottom: 4dp; }
#weapon-slots { font-family: TacticalDisplay; font-size: 10dp; line-height: 14dp; color: ${secondary}; margin-bottom: 8dp; }
#grenades { font-family: TacticalDisplay; font-size: 12dp; color: ${secondary}; margin-bottom: 4dp; }
.ammo { font-family: TacticalHeading; font-size: 52dp; line-height: 56dp; }
.reserve { font-family: TacticalDisplay; font-size: 20dp; color: ${secondary}; }
#ammo.low-ammo { color: ${accent}; }
#weapon-state { padding-top: 6dp; border-top: 1dp ${secondary}55; }
#weapon-state.reloading { color: ${accent}; }
#vitals { position: absolute; left: 32dp; bottom: 32dp; width: 250dp; font-effect: shadow(1dp 1dp ${background}); }
#survival-labels { display: flex; justify-content: space-between; align-items: center; font-family: TacticalDisplay; font-size: 11dp; color: ${secondary}; }
#health-value { font-family: TacticalHeading; font-size: 36dp; color: ${text}; margin-left: 8dp; }
#health { width: 100%; height: 5dp; margin-top: 6dp; background-color: ${border}; }
#health fill { background-color: ${text}; }
#armour { display: flex; gap: 4dp; margin-top: 8dp; }
.armour-slot { width: 78dp; height: 4dp; background-color: ${border}; border: 1dp ${muted}66; }
.armour-slot.filled { background-color: ${text}; border-color: ${text}; }
#supply-counts, #supply-use { font-family: TacticalDisplay; font-size: 10dp; color: ${secondary}; margin-top: 7dp; line-height: 14dp; }
#crosshair { position: absolute; left: 50%; top: 50%; width: 2px; height: 2px; margin-left: -1px; margin-top: -1px; }
#crosshair.hidden { visibility: hidden; }
.arm, .dot { position: absolute; background-color: ${text}; }
.top, .bottom { width: 2px; height: 9px; left: 0; } .left, .right { width: 9px; height: 2px; top: 0; }
/* Spread is projected by PlayerHud in vh. Retain its 9px arm/2px centre geometry. */
.top { top: 0; margin-top: -11px; } .right { left: 0; margin-left: 4px; } .bottom { top: 0; margin-top: 4px; } .left { left: 0; margin-left: -11px; }
.dot { width: 2px; height: 2px; }
.arm.hit { background-color: ${enemy}; } #crosshair.headshot .arm, #crosshair.elimination .arm { background-color: ${accent}; } #crosshair.armour-hit .arm { background-color: ${friendly}; }
#interaction { position: absolute; left: 30%; right: 30%; bottom: 22%; text-align: center; font-family: TacticalDisplay; font-size: 16dp; }
#combat-cue { position: absolute; top: 58%; left: 30%; right: 30%; text-align: center; font-family: TacticalHeading; font-size: 22dp; color: ${accent}; }
#loadout-choice { position: absolute; top: 38%; left: 32dp; max-width: 360dp; font-family: TacticalDisplay; font-size: 13dp; line-height: 22dp; }
#round-progress { position: absolute; bottom: 12dp; left: 32dp; font-family: TacticalDisplay; font-size: 10dp; color: ${muted}; }
.incoming { position: absolute; background-color: ${critical}; } .incoming.hidden { visibility: hidden; }
#incoming-front { top: 42%; left: 47%; width: 6%; height: 3px; } #incoming-back { top: 58%; left: 47%; width: 6%; height: 3px; } #incoming-left { top: 47%; left: 45%; width: 3px; height: 6%; } #incoming-right { top: 47%; left: 55%; width: 3px; height: 6%; }
#damage-overlay, #death-red, #death-black { position: absolute; left: 0; right: 0; top: 0; bottom: 0; pointer-events: none; }
#damage-overlay { background-color: #b0000014; border: 18dp ${critical}cc; box-sizing: border-box; }
#death-red { background-color: #a80000; } #death-black { background-color: #000000; }
#damage-overlay.hidden, #death-red.hidden, #death-black.hidden { visibility: hidden; }
@media (max-width: 1100px) { #objective { width: 240dp; left: 24dp; padding: 10dp 12dp; } #kill-feed { width: 220dp; right: 24dp; top: 214dp; } #compass { width: 240dp; margin-left: -120dp; } #vitals { left: 24dp; width: 210dp; } #weapon { right: 24dp; width: 210dp; } .armour-slot { width: 64dp; } #loadout-choice { top: 42%; max-width: 260dp; font-size: 11dp; line-height: 18dp; } }

#flash-overlay { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: white; opacity: 0; pointer-events: none; }

#spectator-status { position: absolute; left: 20%; right: 20%; bottom: 32dp; text-align: center; font-family: TacticalDisplay; font-size: 18dp; color: ${text}; background-color: ${background}ee; line-height: 26dp; z-index: 10; pointer-events: none; }

#match-strip { width: 360dp; max-width: 80%; margin-left: -180dp; padding: 6dp 12dp; }
.team-score { display: flex; align-items: center; gap: 6dp; }
.score-team-name { font-family: TacticalDisplay; font-size: 12dp; }
.score-row.alpha-team { background-color: ${teamAlpha}15; }
.score-row.bravo-team { background-color: ${teamBravo}15; }
.score-row.observer-team { background-color: ${secondary}0c; }
#spectator-status { left: 30%; right: 30%; max-width: 90%; padding: 8dp; box-sizing: border-box; font-size: 15dp; }
#scoreboard { max-height: 70%; overflow-y: auto; }
@media (max-width: 700px) { #match-strip { left: 10%; right: 10%; width: auto; margin-left: 0; } .score-team-name { display: none; } #spectator-status { left: 5%; right: 5%; bottom: 140dp; font-size: 12dp; } #scoreboard { left: 5%; right: 5%; } }

.scoreboard-heading span { width: 10%; text-align: right; }
.scoreboard-heading span:first-child { width: 65%; text-align: left; }

/* Confirmed hits stay visible through ADS; geometry stays aligned to viewport centre. */
#hitmarker { position: absolute; left: 50%; top: 50%; width: 36px; height: 36px; margin-left: -18px; margin-top: -18px; pointer-events: none; }
#hitmarker.hidden { visibility: hidden; }
#hitmarker .hit-stroke { position: absolute; width: 10px; height: 2px; background-color: white; border: 1px #101010dd; }
#hitmarker .hit-nw { left: 2px; top: 6px; transform: rotate(45deg); }
#hitmarker .hit-ne { right: 2px; top: 6px; transform: rotate(-45deg); }
#hitmarker .hit-sw { left: 2px; bottom: 6px; transform: rotate(-45deg); }
#hitmarker .hit-se { right: 2px; bottom: 6px; transform: rotate(45deg); }
#hitmarker.headshot .hit-stroke { background-color: #ffdb83; }
#hitmarker.elimination .hit-stroke { background-color: #ff5454; }

/* Tactical map. Layers are sized/offset in % of a square frame by TacticalMapPresenter; north is up. */
#minimap { top: 32dp; right: 32dp; width: 212dp; padding: 6dp; background-color: ${panel}b8; }
#minimap.hidden, #tactical-map.hidden, .map-contact.hidden { display: none; }
/* clip: always; RmlUi only scissors overflow it measures, and panned layers can sit at negative offsets. */
.map-frame { position: relative; overflow: hidden; clip: always; background-color: ${background}cc; border: 1dp ${border}; }
#minimap-frame { width: 100%; height: 198dp; box-sizing: border-box; }
.map-layer { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.map-image { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.map-contacts { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.minimap-north, .tactical-map-north { position: absolute; top: 9dp; left: 50%; width: 16dp; margin-left: -8dp; text-align: center; font-family: TacticalHeading; font-size: 12dp; color: ${accent}; font-effect: shadow(1dp 1dp ${background}); }
.map-caption { margin-top: 5dp; font-family: TacticalDisplay; font-size: 10dp; letter-spacing: 1dp; color: ${secondary}; text-align: right; }
.map-contact { position: absolute; width: 14dp; height: 14dp; margin-left: -7dp; margin-top: -7dp; }
.map-arrow { display: block; width: 100%; height: 100%; image-color: ${friendly}; }
.map-dot { display: none; }
.map-contact.self { width: 18dp; height: 18dp; margin-left: -9dp; margin-top: -9dp; z-index: 2; }
.map-contact.self .map-arrow { image-color: ${accent}; }
.map-contact.enemy { width: 10dp; height: 10dp; margin-left: -5dp; margin-top: -5dp; z-index: 1; }
.map-contact.enemy .map-arrow { display: none; }
.map-contact.enemy .map-dot { display: block; box-sizing: border-box; width: 100%; height: 100%; border-radius: 5dp; background-color: ${enemy}; border: 1dp ${background}; }
#tactical-map { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background-color: ${background}99; z-index: 5; }
#scoreboard { z-index: 6; }
#tactical-map-panel { position: relative; padding: 14dp 16dp; background-color: ${panel}f2; border-top: 2dp ${accent}; }
.tactical-map-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 10dp; }
#tactical-map-name { font-family: TacticalHeading; font-size: 24dp; line-height: 26dp; }
.tactical-map-legend { font-family: TacticalDisplay; font-size: 11dp; letter-spacing: 1dp; }
.tactical-map-legend span { margin-left: 14dp; }
.legend-self { color: ${accent}; } .legend-friendly { color: ${friendly}; } .legend-enemy { color: ${enemy}; }
#tactical-map-frame { width: 72vh; height: 72vh; }
#tactical-map-frame .map-contact { width: 20dp; height: 20dp; margin-left: -10dp; margin-top: -10dp; }
#tactical-map-frame .map-contact.self { width: 24dp; height: 24dp; margin-left: -12dp; margin-top: -12dp; }
#tactical-map-frame .map-contact.enemy { width: 12dp; height: 12dp; margin-left: -6dp; margin-top: -6dp; }
#tactical-map-frame .map-contact.enemy .map-dot { border-radius: 6dp; }
#tactical-map-hint { margin-top: 8dp; text-align: right; }
@media (max-width: 1100px) { #minimap { top: 24dp; right: 24dp; width: 172dp; } #minimap-frame { height: 158dp; } }
