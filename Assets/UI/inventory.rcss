@font-face { font-family: GameUIFont; src: url("../Fonts/Georama.ttf"); }
body { width: 100%; height: 100%; margin: 0; color: #f4f8ff; font-family: GameUIFont; }
#inventory-backdrop { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; background-color: #05080db8; backdrop-filter: blur(4px); }
#inventory-panel { box-sizing: border-box; width: 900px; height: 680px; padding: 30px; background-color: #101722f2; border: 1px solid #33495f; }
#header { height: 60px; display: flex; justify-content: space-between; align-items: flex-end; }
.eyebrow { color: #58c8ff; font-size: 12px; letter-spacing: 3px; }
.title { margin-top: 4px; font-size: 34px; }
.capacity { color: #8292a3; font-size: 13px; letter-spacing: 2px; }
#inventory-grid { width: 840px; height: 478px; margin-top: 10px; display: flex; flex-wrap: wrap; gap: 10px; }
.slot { box-sizing: border-box; width: 160px; height: 112px; padding: 12px; background-color: #0b1119; border: 1px solid #293b4d; color: #516171; }
.slot:hover { border-color: #58c8ff; background-color: #152333; }
.slot.occupied { cursor: move; color: #f4f8ff; background-color: #182431; border-color: #3d5870; }
.slot.dragging { opacity: 0.4; border-color: #58c8ff; }
.item-type { color: #58c8ff; font-size: 10px; letter-spacing: 1px; }
.item-name { margin-top: 12px; font-size: 15px; }
.item-count { margin-top: 12px; color: #a8b3c2; font-size: 12px; }
.empty-label { margin-top: 35px; text-align: center; font-size: 10px; letter-spacing: 2px; }
#footer { display: flex; justify-content: space-between; margin-top: 18px; color: #8292a3; font-size: 11px; letter-spacing: 1px; }
.close-hint { color: #58c8ff; }
