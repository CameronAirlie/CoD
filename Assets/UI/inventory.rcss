/* Generated stylesheet source; shared tokens are defined in theme.tokens.json. */
#inventory-backdrop { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; background-color: #090B0Dcc; }
#inventory-panel { width: 900dp; max-width: 92%; max-height: 94%; overflow-y: auto; padding: 24dp; border-top: 2dp #FFB31A; }
#header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1dp #2A3036; padding-bottom: 16dp; }
.title { margin-top: 4dp; }
.section-label { display: flex; justify-content: space-between; margin: 16dp 0 12dp; }
#weapon-grid { display: flex; gap: 12dp; }
.weapon-card { box-sizing: border-box; width: 33.33%; padding: 12dp; border: 1dp #2A3036; background-color: #090B0D; color: #F2F4F5; text-align: left; }
.weapon-card:hover, .weapon-card:focus { border-color: #FFB31A; background-color: #1B1C20; }
.weapon-card.selected { border-color: #FFB31A; background-color: #FFB31A0c; }
.card-top { display: flex; justify-content: space-between; }
.card-top .ui-meta { font-size: 10dp; }
.equipped-tag { visibility: hidden; font-family: TacticalDisplay; font-size: 10dp; color: #FFB31A; }
.selected .equipped-tag { visibility: visible; }
.weapon-portrait { display: block; width: 100%; height: 100dp; }
.weapon-card-name { font-family: TacticalHeading; font-size: 28dp; }
.weapon-stats { margin-top: 4dp; font-family: TacticalDisplay; font-size: 11dp; color: #A6A0B4; }
#inventory-grid { display: flex; flex-wrap: wrap; gap: 10dp; }
.slot { box-sizing: border-box; width: 23.9%; height: 104dp; padding: 12dp; background-color: #090B0D; border: 1dp #2A3036; color: #626B74; }
.slot:hover { border-color: #FFB31A; }
.slot.occupied { cursor: move; color: #F2F4F5; background-color: #1B1C20; }
.slot.dragging { opacity: 0.4; border-color: #FFB31A; }
.item-type { color: #626B74; font-family: TacticalDisplay; font-size: 10dp; letter-spacing: 1dp; }
.item-name { margin-top: 6dp; font-family: TacticalHeading; font-size: 19dp; }
.item-count { margin-top: 6dp; color: #A6A0B4; font-family: TacticalDisplay; font-size: 12dp; }
.item-icon { float: right; width: 30dp; height: 30dp; margin-top: 4dp; }
.empty-label { margin-top: 28dp; text-align: center; font-family: TacticalDisplay; font-size: 10dp; letter-spacing: 2dp; }
#footer { display: flex; justify-content: space-between; margin-top: 16dp; border-top: 1dp #2A3036; padding-top: 16dp; }
.close-hint { color: #FFB31A; }
@media (max-height: 650px) { #inventory-panel { padding: 16dp; } #header { padding-bottom: 8dp; } .title { font-size: 30dp; line-height: 32dp; } .section-label { margin: 10dp 0 8dp; } .weapon-portrait { height: 64dp; } .slot { height: 80dp; padding: 8dp; } .item-name { font-size: 16dp; } #footer { margin-top: 8dp; padding-top: 8dp; } }

#shop-status { margin-top: 12dp; }
#shop-grid, #throwable-grid { display: flex; flex-wrap: wrap; gap: 6dp; margin-top: 8dp; }
.shop-button { padding: 8dp; color: #F2F4F5; background-color: #1B1C20; border: 1dp #2A3036; font-size: 12dp; }
.shop-button:hover, .shop-button:focus { border-color: #FFB31A; }
scrollbarvertical { width: 8dp; }

#shop-summary { display: flex; justify-content: space-between; align-items: center; margin-top: 16dp; padding: 16dp; background-color: #090B0D; border: 1dp #2A3036; }
#shop-balance { font-family: TacticalHeading; font-size: 38dp; color: #FFB31A; }
#shop-grid .shop-button { box-sizing: border-box; width: 23%; flex-grow: 1; text-align: left; padding: 12dp; }
.shop-name { font-family: TacticalDisplay; font-size: 13dp; }
.shop-price { font-family: TacticalHeading; font-size: 26dp; margin-top: 6dp; }
.shop-detail, .shop-action { font-size: 11dp; margin-top: 6dp; }
.shop-action { color: #FFB31A; }
.unavailable { opacity: .65; }
.unavailable .shop-action { color: #A6A0B4; }
.shop-button.unavailable { tab-index: none; }
.weapon-card.unavailable { tab-index: none; }
@media (max-width: 800px) { #shop-grid .shop-button { width: 46%; } #weapon-grid { flex-wrap: wrap; } .weapon-card { width: 100%; } #footer, #header { flex-wrap: wrap; } }

#loadout-selector { display: none; }
#loadout-grid { display: flex; flex-wrap: wrap; gap: 10dp; margin-top: 12dp; }
.loadout-card { box-sizing: border-box; flex-grow: 1; width: 30%; padding: 14dp; text-align: left; background-color: #090B0D; color: #F2F4F5; border: 1dp #2A3036; }
.loadout-card:hover, .loadout-card:focus { border-color: #FFB31A; background-color: #1B1C20; }
.loadout-card.selected { border-color: #FFB31A; background-color: #1B1C20; }
.loadout-portrait { display: block; width: 100%; height: 70dp; }
.loadout-name { font-family: TacticalHeading; font-size: 26dp; margin-top: 8dp; }
.loadout-details { font-family: TacticalDisplay; font-size: 12dp; color: #A6A0B4; margin-top: 6dp; }
.loadout-action { font-family: TacticalDisplay; font-size: 11dp; color: #FFB31A; margin-top: 12dp; }
.loadout-card.selected .loadout-action { font-weight: bold; }
.preset-mode .weapon-portrait { height: 50dp; }
.preset-mode .weapon-card-name { font-size: 22dp; }
@media (max-width: 700px) { .loadout-card { width: 100%; } }
