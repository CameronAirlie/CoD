@font-face {
    font-family: GameUIFont;
    src: url("../Fonts/Georama.ttf");
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    color: #f4f8ff;
    font-family: GameUIFont;
}

#backdrop {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #05080dcc;
    backdrop-filter: blur(4px);
}

#menu {
    width: 390px;
    padding: 34px;
    background-color: #101722f2;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.eyebrow {
    color: #58c8ff;
    font-size: 13px;
    letter-spacing: 3px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 8px;
}

h1 {
    margin: 8px 0 28px 0;
    font-size: 38px;
}

button {
    display: block;
    width: 100%;
    height: 48px;
    line-height: 48px;
    color: #dce8f5;
    background-color: #1a2634;
    border: 1px solid #33495f;
    text-align: center;
    align-items: center;
    font-family: GameUIFont;
    font-size: 16px;
}

button:hover,
button:focus {
    color: #ffffff;
    background-color: #25445d;
    border-color: #58c8ff;
}

button:active {
    background-color: #58c8ff;
    color: #071019;
}

.hint {
    margin-top: 24px;
    color: #8292a3;
    font-size: 12px;
}