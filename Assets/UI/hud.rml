<rml>
<head>
    <title>PlutoGE RmlUi HUD</title>
    <link type="text/rcss" href="hud.rcss"/>
</head>
<body>
    <div id="hud">
        <div id="damage-overlay" class="hidden"></div>
        <div id="objective" class="panel">
            <div id="match-mode" class="eyebrow">HARDPOINT</div>
            <div id="match-phase">WAITING FOR PLAYERS</div>
            <div id="objective-status"></div>
            <div id="objective-detail"></div>
            <div id="objective-instruction"></div>
            <div id="objective-rotation"></div>
        </div>

        <div id="match-strip" class="panel">
            <span id="alpha-score" class="alpha">0</span>
            <span id="match-clock">05:00</span>
            <span id="bravo-score" class="bravo">0</span>
        </div>

        <div id="score-goal"></div>
        <div id="kill-feed"></div>

        <div id="scoreboard" class="hidden panel">
            <div id="scoreboard-mode" class="scoreboard-title">HARDPOINT</div>
            <div class="scoreboard-heading"><span>PLAYER</span><span>K</span><span>D</span><span id="scoreboard-objective-heading">OBJ</span></div>
            <div id="scoreboard-rows"></div>
        </div>

        <div id="crosshair">
            <div id="crosshair-top" class="arm top"></div>
            <div id="crosshair-right" class="arm right"></div>
            <div id="crosshair-bottom" class="arm bottom"></div>
            <div id="crosshair-left" class="arm left"></div>
            <div class="dot"></div>
        </div>
        <div id="interaction"></div>
        <div id="combat-cue"></div>
        <div id="loadout-choice" class="loadout"></div>
        <div id="round-progress"></div>
        <div id="incoming-front" class="incoming hidden"></div>
        <div id="incoming-right" class="incoming hidden"></div>
        <div id="incoming-back" class="incoming hidden"></div>
        <div id="incoming-left" class="incoming hidden"></div>

        <div id="weapon" class="panel">
            <div id="weapon-name">AR-24 ASSAULT RIFLE</div>
            <div id="weapon-slots">1 AR / 2 PISTOL / 3 MG / Q CYCLE</div>
            <div id="grenades">F FRAG / 2 LEFT</div>
            <div class="ammo"><span id="ammo">30</span><span id="reserve" class="reserve"> / 120</span></div>
            <div id="survival-labels"><span>HEALTH <span id="health-value">100</span></span><span>ARMOUR</span></div>
            <progress id="health" value="100" max="100"></progress>
            <div id="supply-counts"></div><div id="supply-use"></div>
            <div id="armour">
                <div id="armour-0" class="armour-slot"></div>
                <div id="armour-1" class="armour-slot"></div>
                <div id="armour-2" class="armour-slot"></div>
            </div>
        </div>
        <div id="death-red" class="hidden"></div>
        <div id="death-black" class="hidden"></div>
    </div>
</body>
</rml>
