@font-face { font-family: ObjectiveFont; src: url("../Fonts/Georama.ttf"); }
body { width: 340px; height: 44px; margin: 0; pointer-events: none; font-family: ObjectiveFont; }
#marker { width: 338px; height: 42px; line-height: 42px; text-align: center; color: #ffdf7f; background-color: #101720cc; border: 1px solid #ffdf7f; font-size: 16px; }
#marker.hidden { visibility: hidden; }
#marker.contested { color: #ff675f; border-color: #ff675f; }
