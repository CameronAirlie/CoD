@font-face { font-family: InstrumentFont; src: url("../Fonts/Georama.ttf"); }
body { width: 100%; height: 100%; margin: 0; color: #ffffff; font-family: InstrumentFont; pointer-events: none; }
#vehicle-instruments { position: absolute; right: 38dp; bottom: 30dp; width: 330dp; height: 330dp; }
.dial { position: absolute; left: 20dp; top: 20dp; width: 286dp; height: 286dp; border-radius: 150dp; border: 3dp #d9e4ec; background-color: #071019dc; }
.inner-ring { position: absolute; left: 17dp; top: 17dp; width: 246dp; height: 246dp; border-radius: 130dp; border: 1dp #71808c99; }
.tick { position: absolute; left: 137dp; top: 7dp; width: 4dp; height: 272dp; transform-origin: 2dp 136dp; background-color: transparent; }
.tick-line { width: 4dp; height: 17dp; background-color: #eaf6ff; }
.tick span { position: absolute; top: 22dp; left: -7dp; width: 18dp; text-align: center; font-size: 14dp; color: #aab8c3; }
.tick.hot .tick-line { background-color: #ff3d2e; }
.tick.hot span { color: #ff6b5e; }
.t0 { transform: rotate(-130deg); } .t1 { transform: rotate(-97.5deg); }
.t2 { transform: rotate(-65deg); } .t3 { transform: rotate(-32.5deg); }
.t4 { transform: rotate(0deg); } .t5 { transform: rotate(32.5deg); }
.t6 { transform: rotate(65deg); } .t7 { transform: rotate(97.5deg); }
.t8 { transform: rotate(130deg); }
.needle { position: absolute; left: 140dp; top: 139dp; width: 3dp; height: 3dp; transform-origin: 1dp 1dp; }
.needle div { position: absolute; left: -1dp; bottom: 0; width: 3dp; height: 108dp; background-color: #f4f8fb; }
.rpm-needle div { width: 2dp; height: 120dp; background-color: #ff493b; }
.speed-needle div { height: 95dp; background-color: #81d8ff; }
.hub { position: absolute; left: 131dp; top: 130dp; width: 20dp; height: 20dp; border-radius: 12dp; background-color: #f2f6f8; border: 3dp #26343f; }
.readout { position: absolute; left: 76dp; top: 157dp; width: 130dp; text-align: center; }
.gear-caption { color: #7e8e9a; font-size: 9dp; letter-spacing: 2dp; }
#vehicle-gear { font-size: 34dp; line-height: 34dp; color: #ffffff; }
#vehicle-speed { margin-top: 5dp; font-size: 42dp; line-height: 42dp; font-weight: bold; letter-spacing: 2dp; }
#speed-unit { color: #80d8ff; font-size: 11dp; letter-spacing: 3dp; }
.rpm-row { margin-top: 5dp; color: #aab7c1; font-size: 11dp; }
#engine-rpm.redline { color: #ff493b; }
.rev-track { position: absolute; left: 51dp; bottom: 8dp; width: 230dp; height: 8dp; background-color: #27333c; border: 1dp #7d8c97; }
#rev-arc-fill { width: 100%; height: 100%; background-color: #38bdf8; transform: scaleX(0); transform-origin: 0% 50%; }
.rpm-caption { position: absolute; bottom: -9dp; left: 115dp; width: 100dp; text-align: center; color: #82919c; font-size: 9dp; letter-spacing: 1dp; }
#shift-light { position: absolute; left: 126dp; top: 3dp; width: 78dp; height: 7dp; background-color: #351411; border: 1dp #7b2b24; }
#shift-light.active { background-color: #ff3125; border-color: #ffffff; }
