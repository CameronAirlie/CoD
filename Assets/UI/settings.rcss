/* Explicit column sizing avoids intrinsic flex shrink in RmlUi. */
#settings-overlay { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #090B0Df2; align-items: center; justify-content: center; }
#settings-panel { box-sizing: border-box; width: 920px; max-width: 90%; max-height: 80%; overflow-y: auto; padding: 24px; border-top: 2px #FFB31A; }
.settings-layout { display: flex; flex-direction: row; align-items: flex-start; width: 100%; margin: 24px 0; }
.settings-tabs { box-sizing: border-box; width: 25%; flex-shrink: 0; padding-right: 24px; }
.settings-tabs button { box-sizing: border-box; display: block; width: 100%; margin-bottom: 8px; padding: 12px; }
.settings-content { box-sizing: border-box; width: 75%; flex-shrink: 0; padding-left: 20px; border-left: 1px #2A3036; }
.settings-section { display: none; width: 100%; }
.settings-section.settings-active { display: block; }
.settings-content p { margin: 16px 0; color: #A6A0B4; }
.settings-content > div > button { min-width: 120px; margin-top: 16px; }
.setting-row { margin: 16px 0; }
.setting-row button { width: 44px; display: inline-block; }
.setting-value { display: inline-block; width: 80px; text-align: center; }
#settings-status { margin: 16px 0; color: #A6A0B4; }
#settings-close, #settings-reset { display: inline-block; margin-right: 12px; }
@media (max-height: 650px) { #settings-panel { padding: 16px; max-height: 88%; } .settings-layout { margin: 16px 0; } .settings-tabs button { padding: 8px; margin-bottom: 6px; } }

.settings-control-label { margin-top: 20px; font-family: TacticalHeading; font-size: 18px; }

/* Consistent two-column setting cards, using RmlUi-compatible flex sizing. */
.settings-section-heading { margin-bottom: 16px; }
.settings-card { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; width: 100%; padding: 18px 16px; margin-bottom: 12px; background-color: #090B0D; border: 1px #2A3036; }
.settings-card-info { box-sizing: border-box; width: 58%; flex-shrink: 0; padding-right: 20px; }
.settings-card-label { display: block; font-family: TacticalHeading; font-size: 18px; margin-bottom: 6px; }
.settings-card-description { color: #A6A0B4; font-size: 12px; line-height: 18px; }
.settings-card-control { box-sizing: border-box; width: 42%; flex-shrink: 0; text-align: right; }
.settings-toggle { box-sizing: border-box; width: 100%; padding: 10px 12px; }
.settings-slider-control .setting-value { display: block; width: 100%; text-align: right; color: #FFB31A; margin-bottom: 8px; }
input.settings-slider { display: block; width: 100%; height: 24px; }
input.settings-slider slidertrack { height: 6px; margin-top: 9px; background-color: #2A3036; }
input.settings-slider sliderprogress { background-color: #FFB31A; }
input.settings-slider sliderbar { width: 12px; height: 24px; margin-top: -9px; background-color: #FFB31A; }
input.settings-slider sliderbar:hover, input.settings-slider sliderbar:active { background-color: #ffca58; }
input.settings-slider sliderarrowdec, input.settings-slider sliderarrowinc { display: none; }
input.settings-slider:focus { background-color: #25241c; }
@media (max-width: 700px) { .settings-card { flex-direction: column; align-items: flex-start; } .settings-card-info, .settings-card-control { width: 100%; } .settings-card-control { margin-top: 12px; } }
