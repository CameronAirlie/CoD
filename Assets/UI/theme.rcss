/* Shared components. Edit theme.tokens.json / this template, then run Tools/build_ui_theme.py. */
@font-face { font-family: TacticalBody; src: url("../Fonts/Inter.ttf"); }
@font-face { font-family: TacticalDisplay; src: url("../Fonts/Rajdhani-Regular.ttf"); }
@font-face { font-family: TacticalHeading; src: url("../Fonts/Rajdhani-Bold.ttf"); }
body { width: 100%; height: 100%; margin: 0; color: #F2F4F5; font-family: TacticalBody; font-size: 14dp; }
div { display: block; }
button, input { font-family: TacticalDisplay; tab-index: auto; }
.ui-panel { box-sizing: border-box; padding: 24dp; background-color: #111417f2; border: 1dp #2A3036; }
.ui-heading { font-family: TacticalHeading; font-size: 40dp; line-height: 44dp; }
.ui-eyebrow { font-family: TacticalDisplay; color: #626B74; font-size: 12dp; letter-spacing: 2dp; }
.ui-meta { font-family: TacticalDisplay; color: #626B74; font-size: 12dp; letter-spacing: 1dp; }
.ui-rule { height: 1dp; background-color: #2A3036; }
.ui-button { box-sizing: border-box; height: 46dp; padding: 0 16dp; line-height: 44dp; border: 1dp #2A3036; background-color: #111417; color: #F2F4F5; font-family: TacticalHeading; font-size: 18dp; text-align: center; }
.ui-button:hover, .ui-button:focus { border-color: #FFB31A; background-color: #25241c; }
.ui-button:active { background-color: #FFB31A; color: #090B0D; }
.ui-button.primary { background-color: #FFB31A; border-color: #FFB31A; color: #090B0D; }
.ui-button.primary:hover, .ui-button.primary:focus { background-color: #ffca58; border-color: #ffca58; }
.ui-button.primary:active { background-color: #e39708; }
.ui-button:disabled { color: #626B74; background-color: #1B1C20; border-color: #2A3036; }
.ui-tab { box-sizing: border-box; padding: 10dp 12dp; border: 1dp #2A3036; background-color: #111417; color: #626B74; font-family: TacticalDisplay; font-size: 16dp; text-align: left; }
.ui-tab:hover, .ui-tab:focus { color: #F2F4F5; border-color: #FFB31A; }
.ui-tab.selected { color: #F2F4F5; background-color: #ffb31a0d; border-bottom: 2dp #FFB31A; }
.ui-key { display: inline-block; min-width: 22dp; height: 22dp; line-height: 22dp; padding: 0 4dp; margin-right: 8dp; border: 1dp #F2F4F5; color: #F2F4F5; font-family: TacticalHeading; text-align: center; }
.ui-icon { width: 24dp; height: 24dp; }
.ui-field { box-sizing: border-box; height: 46dp; padding: 8dp 12dp; background-color: #090B0D; border: 1dp #2A3036; color: #F2F4F5; font-family: TacticalBody; font-size: 15dp; caret-color: #FFB31A;  }
.ui-field:hover, .ui-field:focus { border-color: #FFB31A; }
.ui-stat { font-family: TacticalHeading; font-size: 36dp; line-height: 38dp; }
.friendly { color: #4DA8FF; }
.enemy { color: #F05252; }
.accent { color: #FFB31A; }
progress { background-color: #2A3036; border: 0; }
progress fill { background-color: #F2F4F5; }
.ui-progress fill { background-color: #FFB31A; }

/* Generated RmlUi scrollbars need explicit thickness; otherwise overflow can consume the content width. */
scrollbarvertical { width: 8dp; }
scrollbarhorizontal { height: 8dp; }
scrollbarvertical slidertrack { width: 8dp; background-color: #1B1C20; }
scrollbarhorizontal slidertrack { height: 8dp; background-color: #1B1C20; }
scrollbarvertical sliderbar { width: 8dp; min-height: 24dp; background-color: #626B74; }
scrollbarhorizontal sliderbar { height: 8dp; min-width: 24dp; background-color: #626B74; }
scrollbarvertical sliderbar:hover, scrollbarhorizontal sliderbar:hover { background-color: #FFB31A; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; }
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0; }
scrollbarcorner { background-color: #1B1C20; }

/* Absolute team identity: never swap these colours with the viewer's allegiance. */
.alpha-team { color: #4DA8FF; }
.bravo-team { color: #FF9F43; }
.observer-team { color: #A6A0B4; }
.team-emblem { display: inline-block; box-sizing: border-box; width: 20dp; height: 20dp; margin: 0 7dp; text-align: center; line-height: 17dp; font-family: TacticalHeading; font-size: 14dp; border: 2dp #F2F4F5; vertical-align: middle; }
.team-emblem span { display: block; }
.alpha-emblem { color: #4DA8FF; border-color: #4DA8FF; transform: rotate(45deg); }
.alpha-emblem span { transform: rotate(-45deg); }
.bravo-emblem { color: #FF9F43; border-color: #FF9F43; border-radius: 10dp; }
.observer-emblem { display: inline-block; padding: 0 4dp; border: 1dp #A6A0B4; font-size: 10dp; line-height: 18dp; }

/* Controller selection is a visible border and fill, independent of DOM keyboard focus. */
.controller-only { display: none; }
.controller-connected .controller-only { display: inline-block; }
.controller-connected .keyboard-only { display: none; }
.ui-button.controller-focus, .ui-tab.controller-focus, .ui-field.controller-focus,
.shop-button.controller-focus, .weapon-card.controller-focus, .loadout-card.controller-focus,
.slot.controller-focus, .keyboard-key.controller-focus, input.settings-slider.controller-focus {
    border: 2dp #FFB31A; background-color: #35311f; color: #F2F4F5;
}
.ui-button.primary.controller-focus { background-color: #ffca58; color: #090B0D; border-color: #F2F4F5; }
.menu-controller-hint { margin-top: 12dp; line-height: 18dp; }
#keyboard-overlay { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #090B0Df2; align-items: center; justify-content: center; }
#keyboard-panel { width: 700dp; max-width: 92%; max-height: 90%; overflow-y: auto; }
#keyboard-title { font-size: 28dp; line-height: 32dp; }
#keyboard-value { height: auto; min-height: 46dp; margin-top: 12dp; word-break: break-all; white-space: pre-wrap; }
#keyboard-length { text-align: right; margin: 4dp 0 12dp; }
.keyboard-row { display: flex; justify-content: center; gap: 4dp; margin-bottom: 4dp; }
.keyboard-key { box-sizing: border-box; width: 9%; height: 38dp; padding: 6dp 0; background-color: #111417; color: #F2F4F5; border: 1dp #2A3036; text-align: center; font-size: 18dp; }
.keyboard-key:hover, .keyboard-key:focus { border-color: #FFB31A; }
.keyboard-actions { display: flex; gap: 8dp; justify-content: center; margin-top: 8dp; }
.keyboard-actions button { width: 24%; font-size: 15dp; }
#keyboard-shift.selected { border-color: #FFB31A; }
.keyboard-hint { margin-top: 12dp; line-height: 18dp; }

#confirm-overlay { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #090B0Df2; align-items: center; justify-content: center; }
#confirm-panel { width: 540dp; max-width: 90%; max-height: 90%; overflow-y: auto; }
#confirm-title { font-size: 30dp; line-height: 34dp; }
#confirm-message { margin-top: 16dp; line-height: 20dp; }
.confirm-actions { display: flex; gap: 12dp; margin-top: 24dp; }
.confirm-actions button { width: 50%; }
